<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="28dp"/>

        <!-- Avatar card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/temp_hero_bg"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:padding="32dp">

            <!-- Avatar circle -->
            <LinearLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/avatar_bg"
                android:gravity="center">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_nav_profile"
                    android:contentDescription="Avatar"
                    android:alpha="0.9"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weather Explorer"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="explorer@weatherscope.app"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="24" android:textColor="@color/accent_blue"
                        android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Locations" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="36dp"
                    android:background="@color/stroke_card"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="142" android:textColor="@color/accent_teal"
                        android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Searches" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="36dp"
                    android:background="@color/stroke_card"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="7d" android:textColor="@color/accent_yellow"
                        android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Streak" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Section: Account -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT"
            android:textColor="@color/label_color"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp">

            <!-- Edit Profile -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/profile_menu_item_bg">
                <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/icon_circle_bg" android:gravity="center">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_edit" android:contentDescription="Edit"/>
                </LinearLayout>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Edit Profile"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" android:contentDescription="Go"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/stroke_card" android:layout_marginStart="52dp"/>

            <!-- Notifications -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/profile_menu_item_bg">
                <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/icon_circle_bg" android:gravity="center">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_bell" android:contentDescription="Bell"/>
                </LinearLayout>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Notifications"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" android:contentDescription="Go"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Section: Preferences -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PREFERENCES"
            android:textColor="@color/label_color"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/profile_menu_item_bg">
                <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/icon_circle_bg" android:gravity="center">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_settings" android:contentDescription="Settings"/>
                </LinearLayout>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Settings"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" android:contentDescription="Go"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/stroke_card" android:layout_marginStart="52dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/profile_menu_item_bg">
                <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/icon_circle_bg" android:gravity="center">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_thermometer" android:contentDescription="Units"/>
                </LinearLayout>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Temperature Unit · °C"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" android:contentDescription="Go"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/stroke_card" android:layout_marginStart="52dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/profile_menu_item_bg">
                <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/icon_circle_bg" android:gravity="center">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_info" android:contentDescription="About"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="About WeatherScope"
                        android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/version"
                        android:textColor="@color/text_secondary" android:textSize="11sp"/>
                </LinearLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right" android:contentDescription="Go"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Logout -->
        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_bg"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                android:background="@drawable/icon_circle_bg" android:gravity="center">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_logout" android:contentDescription="Logout"/>
            </LinearLayout>

            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/logout"
                android:textColor="#F472B6" android:textSize="14sp"
                android:textStyle="bold" android:layout_marginStart="14dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
